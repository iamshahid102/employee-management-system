# ---------------------------------------------------------------------------
# Employee Management System — environment template
# Copy to .env.local and fill in from your Supabase project settings.
# Never commit real values.
# ---------------------------------------------------------------------------

# Public Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon/publishable key. Safe for the browser, guarded by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. Bypasses RLS — must never reach the browser.
# Used only for invitation-based account provisioning.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute base URL used in auth redirect emails (invite / password recovery).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
